@model GameStudio.Infrastructure.Models.ArtistModel

@{
    ViewData["Title"] = "Видалення";
}

<h1>Видалення</h1>

<h3 class="text-danger">Ви впевнені, що хочете видалити цей запис?</h3>
<div>
    <h4>Художник</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Specialization)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Specialization)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MainTool)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.MainTool)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ArtworksCompleted)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ArtworksCompleted)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PublicId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PublicId)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HireDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.HireDate)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.BaseSalary)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.BaseSalary)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" /> |
        <a asp-action="Index">До списку</a>
    </form>
</div>
